rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.isAdmin == false;
      allow update: if isOwner(uid) && request.resource.data.isAdmin == resource.data.isAdmin;
      allow delete: if false;

      match /notificationSubscriptions/{subId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /publicProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /games/{gameId} {
      allow read: if isSignedIn();
      allow write: if false; // Admin SDK jobs bypass rules entirely
    }

    match /leaderboards/{scope}/entries/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /history/{historyId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /seasonArchives/{archiveId} {
      allow read: if isAdmin();
      allow write: if false;
      match /{collectionName}/{docId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /picks/{pickId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
  }
}
